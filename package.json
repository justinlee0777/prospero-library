{
  "version": "2.0.0",
  "type": "module",
  "author": "Justin Lee",
  "workspaces": [
    "src/shared",
    "src/web",
    "src/server"
  ],
  "description": "",
  "license": "ISC",
  "scripts": {
    "serve": "vite",
    "build": "rm -rf dist && npm run build --workspaces && tsx post-build.ts && tsx ./test.ts",
    "format": "prettier -w .",
    "test": "playwright test tests",
    "bump-patch-version": "npm version patch --workspaces",
    "publish:libs": "npm run build && npm publish ./dist/shared && npm publish ./dist/web && npm publish ./dist/server"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
