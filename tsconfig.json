{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["node", "vitest/globals"],
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@prospero-library/web": ["./src/web/index.ts"],
      "@prospero-library/web/*": ["./src/web/*"],
      "@prospero-library/shared": ["./src/shared/index.ts"],
      "@prospero-library/shared/*": ["./src/shared/*"],
      "@prospero-library/server": ["./src/server/index.ts"],
      "@prospero-library/server/*": ["./src/server/*"]
    }
  },
  "references": [{ "path": "./src/web" }, { "path": "./src/server" }],
  "include": ["demos", "globals.d.ts"]
}
